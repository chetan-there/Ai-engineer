# Copy this file to `.env` and fill values.
# Do not commit your real `.env`.

# LLM providers (use one or more)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Vision/multimodal model used for identifying uploaded product photos
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-7b-instruct
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# App/runtime options
RUNTIME_MODE=deterministic
RETRIEVER_MODE=chroma
USE_LANGGRAPH=false
